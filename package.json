{
  "name": "@yrchat/plugin-vite",
  "version": "0.1.1",
  "description": "Vite build integration for YRChat WASM plugins",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest-schema": {
      "types": "./dist/manifest-schema.d.ts",
      "import": "./dist/manifest-schema.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test",
    "check": "pnpm build && node --test",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "vite": ">=5 <9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.8.0"
}
